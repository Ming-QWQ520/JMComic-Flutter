<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件单页内容：一部随机推荐漫画（封面 + 名称 + JM号）。
  由 JmHomeWidgetProvider 按缓存数量动态 addView 到 ViewFlipper。
  点击封面/名称/JM号打开对应漫画详情（ACTION_OPEN_RANDOM + album_id）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/albumCover"
        android:layout_width="62dp"
        android:layout_height="86dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="漫画封面" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/albumName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="随机推荐"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/albumId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="JM:"
            android:textColor="#FFFF8C42"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
