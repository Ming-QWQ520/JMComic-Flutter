<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局：用户页 + 单部随机推荐页（ViewFlipper 静态子页）。

  机制（按需求）：
  - ⟳ 点击一次 = 原生请求一部随机推荐并替换显示，再点一次继续请求
    （不预取一批）；
  - 用户页：名称 / 收藏 / J币 / 经验；点击用户页翻到随机推荐页；
    随机推荐页：封面 + 名称 + JM号，点击打开对应详情，◀ 返回用户页；
  - RemoteViews 不支持触摸手势（横滑会被桌面拦截换屏），
    用点击翻页代替左右滑动；
  - 封面按 albumId 磁盘缓存（widget 进程短命，内存缓存无效）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:background="@drawable/jm_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <!-- 子页 1：用户页（名称 + 收藏/J币/经验，点击翻到随机推荐页） -->
            <LinearLayout
                android:id="@+id/pageUser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/userAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="用户头像" />

                    <TextView
                        android:id="@+id/userName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="10dp"
                        android:text="未登录"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/userStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:text="收藏 - · J币 - · 经验 -"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/userSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingStart="4dp"
                    android:text="点击查看随机推荐"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 子页 2：单部随机推荐漫画 -->
            <LinearLayout
                android:id="@+id/pageComic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/albumCover"
                    android:layout_width="62dp"
                    android:layout_height="86dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="漫画封面" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/albumName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="随机推荐"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/albumJmId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="JM:"
                        android:textColor="#FFFF8C42"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ViewFlipper>

        <!-- 底部操作行：返回用户页 + 页码 + 换一部随机推荐 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="返回用户页" />

            <TextView
                android:id="@+id/pageIndex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text="1/2"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_popup_sync"
                android:contentDescription="换一部随机推荐" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
