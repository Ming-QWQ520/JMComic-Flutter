<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局：随机推荐轮播（每页一部漫画：封面 + 名称 + JM号）。

  - ViewFlipper(@+id/flipper) 的子页由 JmHomeWidgetProvider 通过
    RemoteViews.addView 动态添加（每页对应 layout/jm_widget_page.xml），
    左右翻页由底部 ◀ / ▶ 按钮触发（RemoteViews 不支持触摸手势，
    横滑会被桌面自身拦截为换屏，故用按钮翻页）；
  - 底部行：页码指示 + ◀ ▶ ⟳（刷新拉取新一批随机推荐）；
  - 刷新按钮通过 PendingIntent 拉起 APP（jm_action=widget_refresh），
    由 Flutter 端重新请求随机推荐并写回 widget。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp"
    android:background="#7A1F2A33">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 随机推荐轮播页容器（子页动态添加） -->
        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out" />

        <!-- 底部操作行：页码 + 左右翻页 + 刷新 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pageIndex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="1/1"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="上一部" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="下一部" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_popup_sync"
                android:contentDescription="换一批随机推荐" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
