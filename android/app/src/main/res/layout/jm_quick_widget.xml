<?xml version="1.0" encoding="utf-8"?>
<!--
  迷你小组件（2x1）：单部随机推荐（封面 + 名称 + JM号）。
  点击 = 打开当前显示的漫画详情；⟳ = 原生换一部（不进 APP）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp"
    android:background="@drawable/jm_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="5dp">

        <ImageView
            android:id="@+id/quickCover"
            android:layout_width="44dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="漫画封面" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/quickName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="随机推荐"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/quickJmId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="JM:"
                android:textColor="#FFFF8C42"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/quickRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="换一部" />
    </LinearLayout>
</FrameLayout>
