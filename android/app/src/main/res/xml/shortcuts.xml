<?xml version="1.0" encoding="utf-8"?>
<!--
  长按桌面图标快捷菜单：从上至下
  1. 随机推荐（jm.action.RANDOM）
  2. 每周更新（jm.action.WEEKLY）

  「登录用户名」是动态信息（登录态会变），无法在静态 XML 中实现，
  现阶段以「随机推荐」+「每周更新」两条静态 shortcut 为主；
  动态用户名 shortcut 通过 ShortcutManager 在登录后推送，见
  MainActivity.pushUserShortcut()。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="random"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_random_label"
        android:shortcutLongLabel="@string/shortcut_random_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ming.jmcomic"
            android:targetClass="com.ming.jmcomic.MainActivity">
            <extra android:name="jm_action" android:value="random" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="weekly"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_weekly_label"
        android:shortcutLongLabel="@string/shortcut_weekly_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ming.jmcomic"
            android:targetClass="com.ming.jmcomic.MainActivity">
            <extra android:name="jm_action" android:value="weekly" />
        </intent>
    </shortcut>
</shortcuts>
