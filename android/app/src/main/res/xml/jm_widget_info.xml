<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件配置：
  - minWidth/minHeight 满足 4x2 网格单元（Android 12+ 系统自适应）
  - updatePeriodMillis 1800000（30 分钟，Android 最小允许值）
  - resizeMode 水平+垂直，允许用户调整
  - widgetLayout 指向 layout/jm_widget_layout.xml
  - previewImage 用应用图标做预览
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/jm_widget_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:widgetCategory="home_screen">
</appwidget-provider>
