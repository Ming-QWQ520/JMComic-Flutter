<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷方式/小组件图标：随机播放（双交叉箭头，品牌橙）。
  用 group 旋转 + 描边路径构成经典「随机播放」符号，兼容性好。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 右上方向箭头（↗） -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-35">
        <path
            android:pathData="M4,12L18,12M18,12L14,8M18,12L14,16"
            android:strokeColor="#FFFF7B00"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <!-- 右下方向箭头（↘，交叉） -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="35">
        <path
            android:pathData="M4,12L18,12M18,12L14,8M18,12L14,16"
            android:strokeColor="#FFFF7B00"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
