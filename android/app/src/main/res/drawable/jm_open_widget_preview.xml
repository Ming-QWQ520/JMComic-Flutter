<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 快速随机入口选择预览 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#E61F2A33" />
        </shape>
    </item>
    <item android:left="18dp" android:right="18dp" android:top="14dp" android:bottom="26dp">
        <drawable android:drawable="@drawable/ic_shortcut_random" />
    </item>
    <item android:left="26dp" android:right="26dp" android:bottom="10dp" android:top="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
